package com.alnafi.camel.lab2.routes;

import org.apache.camel.builder.RouteBuilder;

/**
 * A simple Camel route that demonstrates basic file processing
 * This route moves files from input directory to output directory
 */
public class SimpleFileRoute extends RouteBuilder {
    
    @Override
    public void configure() throws Exception {
        
        // Route 1: Simple File Transfer
        from("file:data/input?noop=true")
            .log("Processing file: ${header.CamelFileName}")
            .to("file:data/output");
            
        // Route 2: Timer-based Message Generation
        from("timer:hello?period=5000")
            .setBody(constant("Hello from Camel Route at ${date:now:yyyy-MM-dd HH:mm:ss}"))
            .log("Generated message: ${body}")
            .to("file:data/output?fileName=timer-message-${date:now:yyyyMMdd-HHmmss}.txt");
    }
}
