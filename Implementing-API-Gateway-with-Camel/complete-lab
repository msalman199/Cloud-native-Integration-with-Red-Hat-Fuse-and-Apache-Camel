Create the rate limiting processor:

cat > src/main/java/com/example/gateway/RateLimitProcessor.java << 'EOF'
package com.example.gateway;

import org.apache.camel.Exchange;
import org.apache.camel.Processor;
import org.springframework.stereotype.Component;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicLong;

@Component
public class RateLimitProcessor implements Processor {

    private final ConcurrentHashMap<String, ClientRateLimit> clientLimits = new ConcurrentHashMap<>();
    private final int maxRequestsPerMinute = 10;

    @Override
    public void process(Exchange exchange) throws Exception {
        String clientId = "default-client";
        ClientRateLimit rateLimit = clientLimits.computeIfAbsent(clientId, k -> new ClientRateLimit());

        long currentTime = System.currentTimeMillis();
        long windowStart = currentTime - 60000;

        if (rateLimit.getWindowStart() < windowStart) {
            rateLimit.reset(currentTime);
        }

        if (rateLimit.getRequestCount() >= maxRequestsPerMinute) {
            exchange.getIn().setHeader(Exchange.HTTP_RESPONSE_CODE, 429);
            exchange.getIn().setHeader("X-RateLimit-Limit", maxRequestsPerMinute);
            exchange.getIn().setHeader("X-RateLimit-Remaining", 0);
            exchange.getIn().setBody("{\"error\":\"Rate limit exceeded\",\"message\":\"Too many requests\"}");
            exchange.setRouteStop(true);
            return;
        }

        rateLimit.increment();
        exchange.getIn().setHeader("X-RateLimit-Limit", maxRequestsPerMinute);
        exchange.getIn().setHeader("X-RateLimit-Remaining", maxRequestsPerMinute - rateLimit.getRequestCount());
    }

    private static class ClientRateLimit {
        private final AtomicInteger requestCount = new AtomicInteger(0);
        private final AtomicLong windowStart = new AtomicLong(System.currentTimeMillis());

        public int getRequestCount() {
            return requestCount.get();
        }

        public long getWindowStart() {
            return windowStart.get();
        }

        public void increment() {
            requestCount.incrementAndGet();
        }

        public void reset(long newWindowStart) {
            requestCount.set(0);
            windowStart.set(newWindowStart);
        }
    }
}
EOF
Create the routes class combining mediation, security, and rate limiting:

cat > src/main/java/com/example/gateway/GatewayRoutes.java << 'EOF'
package com.example.gateway;

import org.apache.camel.builder.RouteBuilder;
import org.apache.camel.model.rest.RestBindingMode;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

@Component
public class GatewayRoutes extends RouteBuilder {

    @Autowired
    private SecurityProcessor securityProcessor;

    @Autowired
    private RateLimitProcessor rateLimitProcessor;

    @Override
    public void configure() throws Exception {

        onException(Exception.class)
            .handled(true)
            .setHeader("Content-Type", constant("application/json"))
            .setBody(constant("{\"error\":\"Internal server error\"}"))
            .setHeader("CamelHttpResponseCode", constant(500));

        restConfiguration()
            .component("servlet")
            .bindingMode(RestBindingMode.json)
            .dataFormatProperty("prettyPrint", "true")
            .contextPath("/api/v1");

        rest("/health")
            .get()
            .to("direct:health-check");

        rest("/users")
            .get()
            .to("direct:secured-get-users")
            .get("/{id}")
            .to("direct:secured-get-user-by-id");

        rest("/products")
            .get()
            .to("direct:secured-get-products")
            .get("/{id}")
            .to("direct:secured-get-product-by-id");

        rest("/orders")
            .get("/{id}/details")
            .to("direct:secured-get-order-details");

        from("direct:health-check")
            .setBody(constant("{\"status\":\"UP\",\"service\":\"API Gateway\"}"))
            .setHeader("Content-Type", constant("application/json"));

        from("direct:secured-get-users")
            .process(securityProcessor)
            .process(rateLimitProcessor)
            .to("direct:get-users");

        from("direct:secured-get-user-by-id")
            .process(securityProcessor)
            .process(rateLimitProcessor)
            .to("direct:get-user-by-id");

        from("direct:secured-get-products")
            .process(securityProcessor)
            .process(rateLimitProcessor)
            .to("direct:get-products");

        from("direct:secured-get-product-by-id")
            .process(securityProcessor)
            .process(rateLimitProcessor)
            .to("direct:get-product-by-id");

        from("direct:secured-get-order-details")
            .process(securityProcessor)
            .process(rateLimitProcessor)
            .to("direct:get-order-details");

        from("direct:get-users")
            .log("Routing request to user service: GET /users")
            .setHeader("CamelHttpMethod", constant("GET"))
            .to("http://jsonplaceholder.typicode.com/users?bridgeEndpoint=true")
            .log("Response from user service received");

        from("direct:get-user-by-id")
            .log("Routing request to user service: GET /users/${header.id}")
            .setHeader("CamelHttpMethod", constant("GET"))
            .toD("http://jsonplaceholder.typicode.com/users/${header.id}?bridgeEndpoint=true")
            .log("Response from user service received");

        from("direct:get-products")
            .log("Routing request to product service: GET /posts")
            .setHeader("CamelHttpMethod", constant("GET"))
            .to("http://jsonplaceholder.typicode.com/posts?bridgeEndpoint=true")
            .log("Response from product service received");

        from("direct:get-product-by-id")
            .log("Routing request to product service: GET /posts/${header.id}")
            .setHeader("CamelHttpMethod", constant("GET"))
            .toD("http://jsonplaceholder.typicode.com/posts/${header.id}?bridgeEndpoint=true")
            .log("Response from product service received");

        from("direct:get-order-details")
            .log("Aggregating order details for order ID: ${header.id}")
            .setHeader("CamelHttpMethod", constant("GET"))
            .toD("http://jsonplaceholder.typicode.com/posts/${header.id}?bridgeEndpoint=true")
            .setProperty("orderResponse", body())
            .setHeader("CamelHttpMethod", constant("GET"))
            .to("http://jsonplaceholder.typicode.com/users/1?bridgeEndpoint=true")
            .setProperty("userResponse", body())
            .process(exchange -> {
                String orderJson = exchange.getProperty("orderResponse", String.class);
                String userJson = exchange.getProperty("userResponse", String.class);
                String combined = "{\"order\":" + orderJson + ",\"user\":" + userJson + "}";
                exchange.getIn().setBody(combined);
                exchange.getIn().setHeader("Content-Type", "application/json");
            })
            .log("Order details aggregation completed");
    }
}
EOF
