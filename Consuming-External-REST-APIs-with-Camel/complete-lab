package com.example.camel;

import org.apache.camel.builder.RouteBuilder;
import org.apache.camel.model.dataformat.JsonLibrary;

public class RestConsumerRoute extends RouteBuilder {
    
    @Override
    public void configure() throws Exception {
        
        // Route 1: Basic REST API consumption using JSONPlaceholder
        from("timer://fetchPosts?period=30000&repeatCount=3")
            .routeId("fetch-posts-route")
            .log("Starting to fetch posts from external API...")
            .to("https://jsonplaceholder.typicode.com/posts/1")
            .log("Received response: ${body}")
            .unmarshal().json(JsonLibrary.Jackson)
            .log("Post Title: ${body[title]}")
            .log("Post Body: ${body[body]}");
            
        // Route 2: Fetch multiple posts
        from("timer://fetchMultiplePosts?period=45000&repeatCount=2")
            .routeId("fetch-multiple-posts-route")
            .log("Fetching multiple posts...")
            .to("https://jsonplaceholder.typicode.com/posts?_limit=3")
            .log("Received ${body.size()} posts")
            .unmarshal().json(JsonLibrary.Jackson)
            .split(body())
            .log("Processing post: ${body[title]}");
    }
}
