package com.alnafi.camel.route;

import com.alnafi.camel.processor.MessageEnricherProcessor;
import com.alnafi.camel.processor.MessageValidatorProcessor;
import org.apache.camel.builder.RouteBuilder;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Route builder demonstrating custom processor usage
 */
public class ProcessorDemoRouteBuilder extends RouteBuilder {
    
    private static final Logger logger = LoggerFactory.getLogger(ProcessorDemoRouteBuilder.class);
    
    @Override
    public void configure() throws Exception {
        
        // Route 1: Basic message processing with enrichment
        from("timer:messageGenerator?period=5000")
            .routeId("message-enrichment-route")
            .log("Starting message processing...")
            .setBody(constant("Hello from Camel Processor Lab"))
            .log("Original message: ${body}")
            .process(new MessageEnricherProcessor("EnrichmentProcessor"))
            .log("After enrichment: ${body}")
            .log("Headers: ${headers}")
            .to("log:enriched-messages?level=INFO");
        
        // Route 2: Message validation and processing chain
        from("timer:validationGenerator?period=8000")
            .routeId("message-validation-route")
            .log("Starting validation processing...")
            .choice()
                .when(simple("${random(1,4)} == 1"))
                    .setBody(constant("Short"))
                .when(simple("${random(1,4)} == 2"))
                    .setBody(constant("This is a normal message for processing"))
                .when(simple("${random(1,4)} == 3"))
                    .setBody(constant("This message contains an error keyword"))
                .otherwise()
                    .setBody(constant("This is a very long message that exceeds the maximum length limit and should trigger validation errors"))
            .end()
            .log("Message to validate: ${body}")
            .process(new MessageValidatorProcessor(10, 100))
            .log("Validation status: ${header.ValidationStatus}")
            .log("Validation errors: ${header.ValidationErrors}")
            .log("Word count: ${header.MessageWordCount}")
            .choice()
                .when(header("ValidationStatus").isEqualTo("VALID"))
                    .log("Processing valid message...")
                    .process(new MessageEnricherProcessor("ValidationProcessor"))
                    .to("log:valid-messages?level=INFO")
                .otherwise()
                    .log("Handling invalid message...")
                    .to("log:invalid-messages?level=WARN")
            .end();
        
        // Route 3: Complex processing pipeline
        from("timer:pipelineGenerator?period=12000")
            .routeId("processing-pipeline-route")
            .log("Starting processing pipeline...")
            .setBody(constant("Pipeline message for comprehensive processing"))
            .log("Pipeline input: ${body}")
            // First processor: Validation
            .process(new MessageValidatorProcessor(5, 200))
            .log("After validation: Status=${header.ValidationStatus}")
            // Second processor: Enrichment (only if valid)
            .choice()
                .when(header("ValidationStatus").isEqualTo("VALID"))
                    .process(new MessageEnricherProcessor("PipelineProcessor"))
                    .log("Pipeline processing completed successfully")
                    .setHeader("PipelineStatus", constant("SUCCESS"))
                .otherwise()
                    .log("Pipeline processing failed due to validation")
                    .setHeader("PipelineStatus", constant("FAILED"))
            .end()
            .to("log:pipeline-results?level=INFO");
    }
}
