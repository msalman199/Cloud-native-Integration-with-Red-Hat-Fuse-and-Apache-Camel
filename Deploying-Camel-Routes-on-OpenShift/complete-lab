Subtask 2.2: Configure the Camel Route
Edit the main Camel route file:
nano src/main/java/com/example/camel/MyRouteBuilder.java
Replace the content with the following Camel route:
package com.example.camel;

import org.apache.camel.builder.RouteBuilder;
import org.springframework.stereotype.Component;

@Component
public class MyRouteBuilder extends RouteBuilder {

    @Override
    public void configure() throws Exception {
        
        // REST endpoint configuration
        restConfiguration()
            .component("servlet")
            .port(8080)
            .bindingMode(org.apache.camel.model.rest.RestBindingMode.json);

        // REST API route
        rest("/api")
            .get("/health").to("direct:health")
            .get("/process/{message}").to("direct:processMessage")
            .post("/data").to("direct:processData");

        // Health check route
        from("direct:health")
            .setBody(constant("{\"status\":\"UP\",\"service\":\"camel-route\"}"))
            .setHeader("Content-Type", constant("application/json"));

        // Message processing route
        from("direct:processMessage")
            .log("Processing message: ${header.message}")
            .transform(simple("Processed: ${header.message} at ${date:now:yyyy-MM-dd HH:mm:ss}"))
            .setHeader("Content-Type", constant("text/plain"));

        // Data processing route with load simulation
        from("direct:processData")
            .log("Processing data: ${body}")
            .process(exchange -> {
                // Simulate some processing load
                Thread.sleep(100);
                String response = String.format(
                    "{\"processed\":true,\"timestamp\":\"%s\",\"data\":\"%s\"}", 
                    java.time.LocalDateTime.now(),
                    exchange.getIn().getBody(String.class)
                );
                exchange.getIn().setBody(response);
            })
            .setHeader("Content-Type", constant("application/json"));

        // Timer-based route for generating metrics
        from("timer:metrics?period=30000")
            .log("Generating metrics at ${date:now:yyyy-MM-dd HH:mm:ss}")
            .setBody(constant("Metrics generated"));
    }
}
