Subtask 4.3: Create Load Testing Script
Create a load testing script to trigger scaling:
nano load-test.sh
Add the following script content:
#!/bin/bash

ROUTE_URL=$(oc get route camel-routes-route -o jsonpath='{.spec.host}')
echo "Starting load test against: http://$ROUTE_URL"

# Function to generate load
generate_load() {
    local endpoint=$1
    local duration=$2
    local concurrent=$3
    
    echo "Generating load for $duration seconds with $concurrent concurrent requests"
    
    for i in $(seq 1 $concurrent); do
        (
            end_time=$((SECONDS + duration))
            while [ $SECONDS -lt $end_time ]; do
                curl -s "http://$ROUTE_URL$endpoint" > /dev/null
                sleep 0.1
            done
        ) &
    done
    
    wait
}

# Test different endpoints
echo "Phase 1: Light load"
generate_load "/camel/api/health" 60 5

echo "Phase 2: Medium load"
generate_load "/camel/api/process/LoadTest" 120 10

echo "Phase 3: Heavy load with data processing"
for i in {1..20}; do
    (
        for j in {1..30}; do
            curl -s -X POST -H "Content-Type: application/json" \
              -d "{\"message\":\"load-test-$i-$j\"}" \
              "http://$ROUTE_URL/camel/api/data" > /dev/null
            sleep 0.05
        done
    ) &
done

wait
echo "Load test completed"
Make the script executable:
chmod +x load-test.sh
