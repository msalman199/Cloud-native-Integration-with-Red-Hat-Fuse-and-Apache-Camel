Subtask 5.6: Test Scaling Scenarios
Scenario 1: CPU-based scaling
# Generate CPU-intensive load
for i in {1..10}; do
    (
        while true; do
            curl -s "http://$ROUTE_URL/camel/api/process/CPUIntensiveTask" > /dev/null
        done
    ) &
done

# Monitor for 5 minutes then stop
sleep 300
pkill -f curl
Scenario 2: Memory-based scaling
# Generate memory-intensive requests
for i in {1..20}; do
    (
        for j in {1..100}; do
            curl -s -X POST -H "Content-Type: application/json" \
              -d "{\"data\":\"$(head -c 1000 /dev/urandom | base64)\"}" \
              "http://$ROUTE_URL/camel/api/data" > /dev/null
            sleep 0.1
        done
    ) &
done

wait
Scenario 3: Scale-down testing
