             -d "body=$message" \
             -H "Content-Type: application/x-www-form-urlencoded" \
             "http://localhost:8161/api/message/$queue_name?type=queue" > /dev/null

        if [ $((i % 10)) -eq 0 ]; then
            echo "Sent $i messages..."
        fi
    done

    echo "Batch of $batch_size messages sent successfully!"
}

